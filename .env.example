# Google (Gmail API + OAuth) — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://triage.node-wealth.com/api/auth/google/callback

# Microsoft (Graph API + OAuth) — from Azure AD app registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://triage.node-wealth.com/api/auth/microsoft/callback

# Copy this directly from Neon's own dashboard — Storage tab → your
# database → Open in Neon → Connection Details → the POOLED connection
# string (hostname contains "-pooler"). Don't use whatever Vercel's
# integration auto-generated under a similar name; copying straight
# from Neon avoids any ambiguity about which variable is current.
# DATABASE_URL=

# Encrypts refresh tokens before they're stored in Postgres.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Protects the bulk IMAP sync endpoint from being triggered by anyone
# who finds the URL. Generate any random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SYNC_SECRET=

# kie.ai — used for AI-generated replies (manual "AI reply" button and
# auto-reply). Get a key at https://kie.ai/api-key
KIE_AI_API_KEY=
